generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum JourneyStatus {
  draft
  published
  archived
}

enum PhotoStatus {
  processing
  ready
  trashed
  failed
}

model AdminUser {
  id           String    @id @default(uuid()) @db.Uuid
  username     String    @unique
  passwordHash String
  enabled      Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
  events       AdminEvent[]
}

model Session {
  id           String    @id @default(uuid()) @db.Uuid
  adminId      String    @db.Uuid
  admin        AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique
  expiresAt    DateTime
  lastActiveAt DateTime  @default(now())
  createdAt    DateTime  @default(now())
  @@index([expiresAt])
}

model LoginAttempt {
  id        String   @id @default(uuid()) @db.Uuid
  ip        String
  username  String
  createdAt DateTime @default(now())
  @@index([ip, createdAt])
  @@index([username, createdAt])
}

model Journey {
  id          String        @id @default(uuid()) @db.Uuid
  slug        String        @unique
  legacyKey   String?       @unique
  city        String
  latin       String
  country     String
  title       String
  description String
  startDate   DateTime      @db.Date
  endDate     DateTime      @db.Date
  latitude    Float?
  longitude   Float?
  status      JourneyStatus @default(draft)
  position    Int           @default(0)
  revision    Int           @default(1)
  deletedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  stops       RouteStop[]
  album       Album?
  @@index([status, deletedAt, position])
}

model RouteStop {
  id        String   @id @default(uuid()) @db.Uuid
  journeyId String   @db.Uuid
  journey   Journey  @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  name      String
  date      DateTime @db.Date
  position  Int
  latitude  Float?
  longitude Float?
  @@unique([journeyId, position])
}

model Album {
  id           String  @id @default(uuid()) @db.Uuid
  journeyId    String  @unique @db.Uuid
  journey      Journey @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  title        String
  coverPhotoId String? @unique @db.Uuid
  cover        Photo?  @relation("Cover", fields: [coverPhotoId], references: [id], onDelete: SetNull)
  photos       Photo[] @relation("AlbumPhotos")
}

model Photo {
  id           String      @id @default(uuid()) @db.Uuid
  albumId      String      @db.Uuid
  album        Album       @relation("AlbumPhotos", fields: [albumId], references: [id], onDelete: Cascade)
  coverOf      Album?      @relation("Cover")
  mediaKey     String      @unique
  mediaVersion Int         @default(1)
  originalName String
  originalExt  String
  width        Int
  height       Int
  title        String
  alt          String
  focalX       Float       @default(50)
  focalY       Float       @default(50)
  position     Int
  status       PhotoStatus @default(processing)
  deletedAt    DateTime?
  createdAt    DateTime    @default(now())
  @@index([albumId, status, position])
}

model AdminEvent {
  id           String    @id @default(uuid()) @db.Uuid
  adminId      String?   @db.Uuid
  admin        AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)
  action       String
  resourceType String
  resourceId   String
  context      Json?
  createdAt    DateTime @default(now())
}
